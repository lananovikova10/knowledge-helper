# YouTrack Configuration
# Base URL formats (choose one based on your instance type):
# - Standalone/InCloud: https://youtrack.example.com
# - Cloud (default): https://example.youtrack.cloud
# - Cloud (MyJetBrains): https://example.myjetbrains.com/youtrack
YOUTRACK_BASE_URL=https://youtrack.jetbrains.com

# Token should be wrapped in quotes if it contains special characters like = or spaces
# Examples:
#   YOUTRACK_TOKEN="perm:abc123"
#   YOUTRACK_TOKEN="perm:some=token=with=equals"
YOUTRACK_TOKEN="your_token_here"

# Analysis Configuration
STALE_THRESHOLD_DAYS=180
